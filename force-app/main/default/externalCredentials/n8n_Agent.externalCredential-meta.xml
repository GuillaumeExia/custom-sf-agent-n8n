<?xml version="1.0" encoding="UTF-8"?>
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <authenticationProtocol>Custom</authenticationProtocol>
    <description>Signs calls to the n8n webhook "sf-utility-chat" with the X-SF-Signature header. The secret (principal parameter "Signature") is entered in Setup only; it is never stored in source.</description>
    <externalCredentialParameters>
        <parameterGroup>n8n_Agent_Principal</parameterGroup>
        <parameterName>n8n_Agent_Principal</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <externalCredentialParameters>
        <parameterGroup>DefaultGroup</parameterGroup>
        <parameterName>X-SF-Signature</parameterName>
        <parameterType>AuthHeader</parameterType>
        <parameterValue>{!$Credential.n8n_Agent.Signature}</parameterValue>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <label>n8n Agent</label>
</ExternalCredential>
