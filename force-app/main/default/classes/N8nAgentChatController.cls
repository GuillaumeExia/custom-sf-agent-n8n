/**
 * Server side of the "Agent" utility-bar chat (LWC n8nAgentChat).
 *
 * Flow: LWC -> sendMessage() -> Named Credential n8n_Agent -> n8n webhook "sf-utility-chat"
 *       -> n8n Agent "UK Car Assistant" -> { reply, sessionId }.
 *
 * Security notes:
 * - The caller's identity is read here from UserInfo, never taken from the browser.
 * - Record context is limited to the fields listed in Agent_Context_Field__mdt and is queried
 *   WITH USER_MODE, so sharing, CRUD and FLS of the running user apply. If the user can't
 *   read the record (or a field), no record data is sent (record = null).
 * - The webhook secret lives in the External Credential n8n_Agent; it never appears in code.
 * - Raw HTTP response bodies are never shown to the user.
 */
public with sharing class N8nAgentChatController {

    @TestVisible static final Integer MAX_MESSAGE_LENGTH = 4000;
    @TestVisible static final Integer TIMEOUT_MS = 120000;
    @TestVisible static final String ENDPOINT = 'callout:n8n_Agent/webhook/sf-utility-chat';
    static final Pattern SESSION_ID_PATTERN = Pattern.compile('^[A-Za-z0-9-]{1,40}$');

    /** Lets tests pin the field configuration instead of depending on deployed CMDT records. */
    @TestVisible static Map<String, String> fieldConfigOverride;

    public class ChatReply {
        @AuraEnabled public String reply;
        @AuraEnabled public String sessionId;
    }

    public class RecordLabel {
        @AuraEnabled public String objectLabel;
        @AuraEnabled public String name;
    }

    /**
     * Sends one chat message to the n8n Agent.
     * @param message   the rep's message (trimmed, 1..4000 chars)
     * @param sessionId conversation id generated by the LWC (crypto.randomUUID)
     * @param recordId  record on screen, or null to send no record context
     */
    @AuraEnabled
    public static ChatReply sendMessage(String message, String sessionId, Id recordId) {
        String text = message == null ? '' : message.trim();
        if (String.isBlank(text)) {
            throw friendly('Please type a message.');
        }
        if (text.length() > MAX_MESSAGE_LENGTH) {
            throw friendly('Your message is too long. Please keep it under 4,000 characters.');
        }
        if (String.isBlank(sessionId) || !SESSION_ID_PATTERN.matcher(sessionId).matches()) {
            throw friendly('This conversation could not be identified. Start a new conversation and try again.');
        }

        Map<String, Object> payload = new Map<String, Object>{
            'message' => text,
            'sessionId' => sessionId,
            'orgId' => UserInfo.getOrganizationId(),
            'user' => new Map<String, Object>{
                'id' => UserInfo.getUserId(),
                'name' => UserInfo.getName(),
                'profile' => currentProfileName()
            },
            'record' => buildRecordContext(recordId)
        };

        HttpRequest req = new HttpRequest();
        req.setEndpoint(ENDPOINT);
        req.setMethod('POST');
        req.setTimeout(TIMEOUT_MS);
        req.setHeader('Content-Type', 'application/json');
        req.setBody(JSON.serialize(payload));

        HttpResponse res;
        try {
            res = new Http().send(req);
        } catch (CalloutException e) {
            throw friendly('The assistant took too long to answer or could not be reached. Please try again.');
        }

        Integer status = res.getStatusCode();
        if (status == 200) {
            return parseReply(res.getBody(), sessionId);
        }
        if (status == 401 || status == 403) {
            throw friendly('The assistant connection is not authorised. Ask your Salesforce administrator to check the n8n_Agent credential.');
        }
        if (status >= 400 && status < 500) {
            throw friendly('The assistant could not process this request. Please rephrase and try again.');
        }
        throw friendly('The assistant is unavailable right now. Please try again in a moment.');
    }

    /**
     * Label shown on the context chip ("Context: Contact Jane Morgan").
     * Returns null when the user can't read the record.
     */
    @AuraEnabled(cacheable=true)
    public static RecordLabel getRecordLabel(Id recordId) {
        if (recordId == null) {
            return null;
        }
        Schema.DescribeSObjectResult describe = recordId.getSObjectType().getDescribe();
        String nameField = null;
        for (Schema.SObjectField f : describe.fields.getMap().values()) {
            if (f.getDescribe().isNameField()) {
                nameField = f.getDescribe().getName();
                break;
            }
        }
        RecordLabel label = new RecordLabel();
        label.objectLabel = describe.getLabel();
        if (nameField == null) {
            return label;
        }
        try {
            List<SObject> rows = Database.query(
                'SELECT ' + nameField + ' FROM ' + describe.getName() + ' WHERE Id = :recordId WITH USER_MODE LIMIT 1'
            );
            if (rows.isEmpty()) {
                return null;
            }
            label.name = String.valueOf(rows[0].get(nameField));
            return label;
        } catch (QueryException e) {
            return null;
        }
    }

    // ---------------------------------------------------------------- helpers

    @TestVisible
    static Map<String, Object> buildRecordContext(Id recordId) {
        if (recordId == null) {
            return null;
        }
        Schema.SObjectType sType = recordId.getSObjectType();
        String objectName = sType.getDescribe().getName();

        List<String> paths = validPaths(sType, configuredPaths(objectName));
        if (paths.isEmpty()) {
            // Object not configured (or no valid fields): send no record data at all.
            return null;
        }

        SObject row;
        try {
            List<SObject> rows = Database.query(
                'SELECT ' + String.join(paths, ', ') + ' FROM ' + objectName +
                ' WHERE Id = :recordId WITH USER_MODE LIMIT 1'
            );
            if (rows.isEmpty()) {
                return null; // not visible to this user (sharing) or deleted
            }
            row = rows[0];
        } catch (QueryException e) {
            return null; // CRUD/FLS denied in user mode
        }

        Map<String, Object> fields = new Map<String, Object>();
        for (String path : paths) {
            fields.put(path, readPath(row, path));
        }
        return new Map<String, Object>{
            'id' => recordId,
            'objectApiName' => objectName,
            'fields' => fields
        };
    }

    /** Raw comma-separated paths for an object, from the override (tests) or active CMDT. */
    static List<String> configuredPaths(String objectName) {
        String raw = null;
        if (fieldConfigOverride != null) {
            raw = fieldConfigOverride.get(objectName);
        } else {
            for (Agent_Context_Field__mdt cfg : Agent_Context_Field__mdt.getAll().values()) {
                if (cfg.Active__c && cfg.Object_API_Name__c == objectName) {
                    raw = cfg.Field_Paths__c;
                    break;
                }
            }
        }
        List<String> result = new List<String>();
        if (String.isBlank(raw)) {
            return result;
        }
        for (String p : raw.split(',')) {
            if (String.isNotBlank(p)) {
                result.add(p.trim());
            }
        }
        return result;
    }

    /** Keeps only paths that exist in the schema: Field or Relationship.Field (one level). */
    @TestVisible
    static List<String> validPaths(Schema.SObjectType sType, List<String> paths) {
        List<String> valid = new List<String>();
        Map<String, Schema.SObjectField> fieldMap = sType.getDescribe().fields.getMap();
        for (String path : paths) {
            List<String> parts = path.split('\\.');
            if (parts.size() == 1) {
                if (fieldMap.containsKey(parts[0].toLowerCase())) {
                    valid.add(path);
                }
            } else if (parts.size() == 2) {
                Schema.SObjectType target = relationshipTarget(fieldMap, parts[0]);
                if (target != null && target.getDescribe().fields.getMap().containsKey(parts[1].toLowerCase())) {
                    valid.add(path);
                }
            }
        }
        return valid;
    }

    static Schema.SObjectType relationshipTarget(Map<String, Schema.SObjectField> fieldMap, String relationshipName) {
        for (Schema.SObjectField f : fieldMap.values()) {
            Schema.DescribeFieldResult d = f.getDescribe();
            if (d.getType() == Schema.DisplayType.REFERENCE
                && d.getRelationshipName() != null
                && d.getRelationshipName().equalsIgnoreCase(relationshipName)
                && !d.getReferenceTo().isEmpty()) {
                return d.getReferenceTo()[0];
            }
        }
        return null;
    }

    static Object readPath(SObject row, String path) {
        List<String> parts = path.split('\\.');
        if (parts.size() == 1) {
            return row.get(parts[0]);
        }
        SObject parent = row.getSObject(parts[0]);
        return parent == null ? null : parent.get(parts[1]);
    }

    static ChatReply parseReply(String body, String sessionId) {
        String replyText;
        try {
            Map<String, Object> parsed = (Map<String, Object>) JSON.deserializeUntyped(body);
            replyText = (String) parsed.get('reply');
        } catch (Exception e) {
            replyText = null;
        }
        if (String.isBlank(replyText)) {
            throw friendly('The assistant returned an empty answer. Please try again.');
        }
        ChatReply result = new ChatReply();
        result.reply = replyText;
        result.sessionId = sessionId;
        return result;
    }

    static String currentProfileName() {
        try {
            List<Profile> p = [SELECT Name FROM Profile WHERE Id = :UserInfo.getProfileId() LIMIT 1];
            return p.isEmpty() ? null : p[0].Name;
        } catch (Exception e) {
            return null;
        }
    }

    /** AuraHandledException whose message is readable by the LWC and by tests. */
    static AuraHandledException friendly(String msg) {
        AuraHandledException e = new AuraHandledException(msg);
        e.setMessage(msg);
        return e;
    }
}
